# Cabeceras de seguridad para Cloudflare Pages.
# El equivalente para Vercel esta en vercel.json (seccion "headers").
# Mantener los dos ficheros sincronizados.

/*
  # Impide que el navegador "adivine" el tipo de un fichero (ataques MIME).
  X-Content-Type-Options: nosniff

  # Nadie puede incrustar la web en un iframe (clickjacking).
  X-Frame-Options: DENY

  # No filtrar la ruta completa al navegar a sitios externos.
  Referrer-Policy: strict-origin-when-cross-origin

  # La web no usa camara, microfono ni geolocalizacion: se deniegan.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Fuerza HTTPS durante un ano.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Content Security Policy.
  #   script-src 'self'  -> solo el JS propio. Sin 'unsafe-inline': por eso se
  #                         quito el onload en linea de index.html.
  #   style-src ademas 'unsafe-inline' -> Framer Motion anima escribiendo en el
  #                         atributo style; sin esto no habria animaciones. Es
  #                         mucho menos peligroso que permitir scripts inline.
  #   connect-src 'self' -> el formulario envia a /api/contact, mismo origen.
  #   frame-ancestors 'none' -> equivalente moderno de X-Frame-Options.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Los assets con hash en el nombre no cambian nunca: se cachean para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
