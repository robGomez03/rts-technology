# Variables de entorno.
#
# En LOCAL: copia este fichero a `.env.local` y rellena los valores.
# En VERCEL: Project Settings -> Environment Variables.

# ─────────────────────────────────────────────────────────────────────────
#  SERVIDOR — nunca llegan al navegador. Las lee api/contact.ts
# ─────────────────────────────────────────────────────────────────────────

# OBLIGATORIA para que el formulario envie correos.
# Se saca de https://resend.com/api-keys (empieza por "re_").
# Sin ella, el formulario abre el cliente de correo del visitante como
# respaldo, asi que no se pierde ninguna solicitud.
RESEND_API_KEY=

# Opcional. Destinatario de las solicitudes.
# Por defecto: rtstechnologyrd@gmail.com
CONTACT_TO=

# Opcional. Remitente.
# Por defecto: "RTS Technology <onboarding@resend.dev>"
#
# OJO: el remitente de pruebas `onboarding@resend.dev` solo puede enviar al
# correo con el que se creo la cuenta de Resend. Para enviar a cualquier otra
# direccion hay que verificar un dominio propio en Resend y poner algo como
# "RTS Technology <web@rtstechnology.do>".
CONTACT_FROM=

# ─────────────────────────────────────────────────────────────────────────
#  CLIENTE — ATENCION: en Vite, todo lo que empieza por VITE_ se incrusta en
#  el JavaScript publico y es visible para cualquiera.
#  Nunca pongas aqui claves de API.
# ─────────────────────────────────────────────────────────────────────────

# Opcional. Solo si quieres que el formulario apunte a otro servicio en lugar
# de a la funcion propia /api/contact (Formspree, Web3Forms, etc.).
VITE_CONTACT_ENDPOINT=
